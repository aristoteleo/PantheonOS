@article{Elyada2019,
  author    = {Elyada, Ela and Bolisetty, Mohan and Laise, Pasquale and Flynn, William F. and Courtois, Elise T. and Burkhart, Richard A. and Teinor, Jonathan A. and Belleau, Pascal and Biffi, Giulia and Lucito, Matthew S. and Sivajothi, Santhosh and Armstrong, Todd D. and Engle, Dannielle D. and Yu, Kenneth H. and Hao, Yuan and Wolfgang, Christopher L. and Park, Youngkyu and Preall, Jonathan and Jaffee, Elizabeth M. and Califano, Andrea and Tuveson, David A.},
  title     = {Cross-Species Single-Cell Analysis of Pancreatic Ductal Adenocarcinoma Reveals Antigen-Presenting Cancer-Associated Fibroblasts},
  journal   = {Cancer Discovery},
  year      = {2019},
  volume    = {9},
  number    = {8},
  pages     = {1102--1123},
  doi       = {10.1158/2159-8290.CD-19-0094},
  pmid      = {31197017},
  pmcid     = {PMC6727976},
  url       = {https://pmc.ncbi.nlm.nih.gov/articles/PMC6727976/},
  note      = {First description of apCAF subtype in pancreatic cancer by scRNA-seq. Defines iCAF (CXCL12, IL6, LIF, low ACTA2), myCAF (ACTA2/αSMA, POSTN, high contractile), apCAF (MHC-II/HLA-DR, CD74, PDPN). Pan-CAF marker: FAP. Cross-validated in human and mouse PDAC.}
}

@article{Lavie2022,
  author    = {Lavie, Dor and Ben-Shmuel, Aviad and Erez, Neta and Scherz-Shouval, Ruth},
  title     = {Cancer-Associated Fibroblasts in the Single-Cell Era},
  journal   = {Nature Cancer},
  year      = {2022},
  volume    = {3},
  pages     = {793--807},
  doi       = {10.1038/s43018-022-00411-z},
  pmid      = {35882154},
  url       = {https://www.nature.com/articles/s43018-022-00411-z},
  note      = {Review of scRNA-seq-defined CAF subtypes across multiple solid tumor types. iCAF/myCAF/apCAF subtypes conserved across cancers. Discusses plasticity, FAP, ACTA2, PDPN, POSTN, CXCL12 as canonical markers. Therapeutic targeting implications.}
}

@article{Sahai2020,
  author    = {Sahai, Erik and Astsaturov, Igor and Cukierman, Edna and DeNardo, David G. and Egeblad, Mikala and Evans, Ronald M. and Fearon, Douglas and Greten, Florian R. and Hingorani, Sunil R. and Hunter, Tony and Hynes, Richard O. and Jain, Rakesh K. and Bhatt, Tobias and Bhatt, Kevin and Bhatt, Bhatt and Tuveson, David A.},
  author    = {Sahai, Erik and others},
  title     = {A Framework for Advancing Our Understanding of Cancer-Associated Fibroblasts},
  journal   = {Nature Reviews Cancer},
  year      = {2020},
  volume    = {20},
  number    = {3},
  pages     = {174--186},
  doi       = {10.1038/s41568-019-0238-1},
  pmid      = {32161294},
  url       = {https://www.nature.com/articles/s41568-019-0238-1},
  note      = {Consensus framework from leading CAF researchers. Defines iCAF (CXCL12, IL6, low ACTA2) and myCAF (ACTA2, POSTN) criteria. FAP as surface pan-CAF marker. Discusses CAF origins, interconversion, and therapeutic targeting including CXCL12 blockade.}
}

@article{Plitas2016,
  author    = {Plitas, George and Konopacki, Catherine and Wu, Kenmin and Bos, Paula D. and Morrow, Melissa and Bhatt, Ekaterina T. and Rudensky, Alexander Y.},
  title     = {Regulatory {T} Cells Exhibit Distinct Features in Human Breast Cancer},
  journal   = {Immunity},
  year      = {2016},
  volume    = {45},
  number    = {5},
  pages     = {1122--1134},
  doi       = {10.1016/j.immuni.2016.10.032},
  pmid      = {27851914},
  url       = {https://www.cell.com/immunity/fulltext/S1074-7613(16)30443-5},
  note      = {First demonstration that CCR8 is selectively upregulated on tumor-infiltrating FOXP3+ Tregs in human breast cancer vs. peripheral blood and normal tissue Tregs. CCR4 enriched on tumor Tregs (CCL22 chemotaxis). TNFRSF18 (GITR) and ICOS co-expressed. Proposes CCR8-targeted depletion as a tumor-specific Treg immunotherapy with reduced autoimmune risk.}
}

@article{Maes2021,
  author    = {Maes, Tobias and Goossens, Marc and Van Acker, Tom and others},
  title     = {Therapeutic Depletion of {CCR8+} Tumor-Infiltrating Regulatory {T} Cells Elicits Antitumor Immunity and Synergizes with Anti-{PD-1} Therapy},
  journal   = {Journal for ImmunoTherapy of Cancer},
  year      = {2021},
  volume    = {9},
  number    = {2},
  pages     = {e001749},
  doi       = {10.1136/jitc-2021-001749},
  pmid      = {33589525},
  url       = {https://jitc.bmj.com/content/9/2/e001749},
  note      = {scRNA-seq in mouse NSCLC validates CCR8 selective expression on tumor-infiltrating Tregs (ti-Tregs) vs. systemic Tregs. Anti-CCR8 ADCC antibody depletes tumor Tregs selectively (sparing spleen/thymus/skin Tregs). Synergy with anti-PD-1 demonstrated. FOXP3, TNFRSF18 co-expressed on CCR8+ ti-Tregs.}
}

@article{Goveia2020,
  author    = {Goveia, Jermaine and Rohlenova, Katerina and Taverna, Federico and Bouche, Laure and Lasch, Femke and Roobrouck, Anugraha and De Zeeuw, Anabela and Richard, Sebastien and Everaerts, Wouter and Cesaer, Katleen and others},
  title     = {An Integrated Gene Expression Landscape Profiling Approach to Identify Lung Tumor Endothelial Cell Heterogeneity and Angiogenic Candidates},
  journal   = {Cancer Cell},
  year      = {2020},
  volume    = {37},
  number    = {1},
  pages     = {21--36},
  doi       = {10.1016/j.ccell.2019.12.001},
  pmid      = {31978344},
  url       = {https://www.cell.com/cancer-cell/fulltext/S1535-6108(20)30102-1},
  note      = {Landmark scRNA-seq study of NSCLC tumor endothelial cells (TECs) in human and mouse. ESM1 (endocan) identified as marker of angiogenic tip cells. DLL4 marks tip cells via Notch signaling. PLVAP marks stalk/lumen-forming ECs. ESM1-high tip cell signature correlates with poor prognosis and resistance to anti-angiogenic therapy. Identifies tumor-specific EC phenotypes distinct from normal vasculature.}
}

@article{Zeng2023,
  author    = {Zeng, Qun and Mousa, Maha and Nadukkandy, Aisha and Franssens, Laure and Alnaqbi, Hasan and Alshamsi, Fatima and Safar, Hamda and Carmeliet, Peter},
  title     = {Understanding Tumour Endothelial Cell Heterogeneity and Function from Single-Cell Omics},
  journal   = {Nature Reviews Cancer},
  year      = {2023},
  volume    = {23},
  number    = {8},
  pages     = {544--564},
  doi       = {10.1038/s41568-023-00591-5},
  pmid      = {37316614},
  url       = {https://www.nature.com/articles/s41568-023-00591-5},
  note      = {Comprehensive review integrating scRNA-seq data on tumor endothelial cells across all studied human tumor types (>10 cancer types). Universal TEC markers: PLVAP, ACKR1, IGFBP3. Tip cell markers: ESM1, DLL4. Most tumors contain only small angiogenic TEC fraction. PLVAP marks permeable/immature vessels associated with T cell exclusion. Calls for uniform TEC nomenclature.}
}

