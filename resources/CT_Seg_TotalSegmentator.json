{
  "tool_name": "TotalSegmentator",
  "tool_description": "TotalSegmentator is an open-source deep learning tool for automatic segmentation of over 100 anatomical structures in CT and MR images. It supports various tasks including organ volumetry, disease characterization, and surgical planning. The tool is available as a Python package, a 3D Slicer extension, and a web application.",
  "tool_author": "Jakob Wasserthal et al.",
  "tool_version": "2.2.1",
  "tool_url": "https://github.com/wasserth/TotalSegmentator",
  "demo_commands": [
    "TotalSegmentator -i ct.nii.gz -o seg -ta lung_vessels --fast",
    "TotalSegmentator -i ct.nii.gz -o seg --ml --statistics --preview",
    "TotalSegmentator -i ct.nii.gz -o seg --roi_subset liver kidney spleen",
    "TotalSegmentator -i ct.nii.gz -o seg --radiomics --save_probabilities probs.npz"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "input",
      "output"
    ],
    "properties": {
      "input": {
        "type": "string",
        "description": "Path to the input CT/MR image file (NIfTI format) or a folder/zip file containing DICOM slices."
      },
      "output": {
        "type": "string",
        "description": "Directory path where the segmentation results will be saved."
      },
      "output_type": {
        "type": "string",
        "enum": [
          "nifti",
          "dicom"
        ],
        "default": "nifti",
        "description": "Format of the output segmentation files."
      },
      "ml": {
        "type": "boolean",
        "default": false,
        "description": "Save one multilabel image for all classes."
      },
      "fast": {
        "type": "boolean",
        "default": false,
        "description": "Use faster lower resolution model (3mm)."
      },
      "preview": {
        "type": "boolean",
        "default": false,
        "description": "Generate a PNG preview of the segmentation."
      },
      "task": {
        "type": "string",
        "enum": [
          "total",
          "lung_vessels",
          "total_mr"
        ],
        "default": "total",
        "description": "Select which model to use. This determines what is predicted."
      },
      "statistics": {
        "type": "boolean",
        "default": false,
        "description": "Calculate volume (in mm\u00b3) and mean intensity. Results will be in statistics.json."
      },
      "radiomics": {
        "type": "boolean",
        "default": false,
        "description": "Calculate radiomics features. Requires pyradiomics. Results will be in statistics_radiomics.json."
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "segmentation_files": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "List of file paths to the generated segmentation masks."
      },
      "statistics_file": {
        "type": "string",
        "description": "Path to the statistics.json file containing volume and mean intensity information."
      },
      "radiomics_file": {
        "type": "string",
        "description": "Path to the statistics_radiomics.json file containing radiomics features."
      },
      "preview_image": {
        "type": "string",
        "description": "Path to the generated PNG preview of the segmentation."
      },
      "probabilities_file": {
        "type": "string",
        "description": "Path to the saved probabilities file, if generated."
      }
    }
  },
