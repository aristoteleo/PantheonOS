{
  "id": "pdf-viewer",
  "name": "PDF Viewer",
  "version": "0.6.4",
  "apiVersion": 2,
  "description": "View PDF documents.",
  "surface": "dom",
  "entry": {
    "frontend": "frontend/main.js"
  },
  "placement": {
    "requires": [
      "dom"
    ]
  },
  "notes": "Bundled headed App — the browser's own PDF engine renders the served URL; no backend.",
  "opens": [
    ".pdf"
  ],
  "defaultFor": [
    ".pdf"
  ],
  "launcher": false,
  "icon": {
    "monochrome": true,
    "tint": "#a44b4e"
  },
  "defaultSize": {
    "width": 820,
    "height": 700
  }
}
