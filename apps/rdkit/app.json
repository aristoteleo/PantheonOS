{
  "id": "rdkit",
  "name": "RDKit Molecules",
  "description": "2D small-molecule depictions from SMILES / SDF (RDKit WebAssembly).",
  "version": "0.1.0",
  "surface": "dom",
  "entry": {
    "frontend": "frontend/index.js"
  },
  "opens": [
    ".sdf",
    ".mol",
    ".smi"
  ],
  "sync": {
    "molecules": {
      "mode": "shared",
      "rate": "commit"
    },
    "draw_options": {
      "mode": "shared",
      "rate": "commit"
    }
  },
  "defaultFor": [],
  "launcher": false,
  "icon": {
    "tint": "#eef1f7",
    "path": "assets/icon.svg"
  },
  "menus": [
    {
      "label": "Data",
      "items": [
        {
          "label": "Load Example Data",
          "action": "$demo"
        }
      ]
    },
    {
      "label": "View",
      "items": [
        {
          "label": "Toggle Atom Indices",
          "action": "toggleIndices"
        }
      ]
    }
  ],
  "actions": [
    {
      "name": "toggleIndices",
      "description": "Number every atom in the depiction"
    }
  ],
  "caps": {
    "fs": [],
    "net": true
  },
  "skill": "skill/SKILL.md",
  "apiVersion": 1
}
