{
  "id": "vitessce",
  "name": "Vitessce",
  "description": "Single-cell visual analytics for AnnData — embeddings, cell sets, heatmaps (Vitessce).",
  "version": "0.1.0",
  "surface": "dom",
  "entry": {
    "frontend": "frontend/index.js",
    "backend": "backend/__init__.py"
  },
  "opens": [
    ".h5ad"
  ],
  "sync": {
    "datasets": {
      "mode": "shared",
      "rate": "commit"
    },
    "layout": {
      "mode": "shared",
      "rate": "commit"
    },
    "name": {
      "mode": "shared",
      "rate": "commit"
    },
    "coordinationSpace": {
      "mode": "shared",
      "rate": "stream"
    }
  },
  "defaultFor": [
    ".h5ad"
  ],
  "launcher": false,
  "icon": {
    "tint": "#eef1f7",
    "path": "assets/icon.svg"
  },
  "menus": [
    {
      "label": "Data",
      "items": [
        {
          "label": "Load Example Data",
          "action": "loadExample"
        },
        {
          "separator": true
        },
        {
          "label": "Compute UMAP",
          "action": "computeUmap"
        }
      ]
    }
  ],
  "actions": [
    {
      "name": "loadExample",
      "description": "Show the bundled example dataset"
    },
    {
      "name": "computeUmap",
      "description": "Compute a UMAP embedding for the opened .h5ad (cached; the file itself is not modified)"
    }
  ],
  "caps": {
    "fs": [],
    "net": true,
    "python": {
      "env": "pantheon-base"
    }
  },
  "skill": "skill/SKILL.md",
  "apiVersion": 1
}
