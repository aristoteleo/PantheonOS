{
  "id": "msa",
  "name": "MSA Viewer",
  "version": "0.1.0",
  "apiVersion": 2,
  "description": "Multiple sequence alignments with Clustal or nucleotide colouring.",
  "kind": "service",
  "surface": "dom",
  "entry": {
    "frontend": "frontend/index.js"
  },
  "placement": {
    "requires": [
      "dom"
    ]
  },
  "opens": [
    ".aln",
    ".fasta",
    ".fa"
  ],
  "defaultFor": [],
  "launcher": false,
  "icon": {
    "tint": "#2e3440",
    "path": "assets/icon.svg"
  },
  "actions": [
    {
      "name": "setColors",
      "params": {
        "scheme": "clustal | nucleotide"
      },
      "description": "Residue colour scheme"
    },
    {
      "name": "toggleRuler",
      "description": "Show/hide the column ruler"
    }
  ],
  "caps": {
    "fs": [],
    "net": true
  },
  "menus": [
    {
      "label": "Data",
      "items": [
        {
          "label": "Load Example Data",
          "action": "$demo"
        }
      ]
    },
    {
      "label": "View",
      "items": [
        {
          "label": "Clustal Colors",
          "action": "setColors",
          "args": {
            "scheme": "clustal"
          }
        },
        {
          "label": "Nucleotide Colors",
          "action": "setColors",
          "args": {
            "scheme": "nucleotide"
          }
        },
        {
          "separator": true
        },
        {
          "label": "Toggle Ruler",
          "action": "toggleRuler"
        }
      ]
    }
  ],
  "skill": "skill/SKILL.md",
  "sync": {
    "sequences": {
      "mode": "shared",
      "rate": "commit"
    },
    "url": {
      "mode": "shared",
      "rate": "commit"
    },
    "color_scheme": {
      "mode": "shared",
      "rate": "commit"
    }
  }
}
