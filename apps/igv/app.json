{
  "id": "igv",
  "name": "IGV",
  "version": "0.1.0",
  "apiVersion": 2,
  "description": "Genome tracks — alignments, variants and signal around any locus (igv.js).",
  "kind": "service",
  "surface": "dom",
  "entry": {
    "frontend": "frontend/index.js"
  },
  "placement": {
    "requires": [
      "dom"
    ]
  },
  "opens": [],
  "defaultFor": [],
  "launcher": false,
  "icon": {
    "tint": "#2f4f9b",
    "path": "assets/icon.svg"
  },
  "actions": [],
  "caps": {
    "fs": [],
    "net": true
  },
  "menus": [
    {
      "label": "Data",
      "items": [
        {
          "label": "Load Example Data",
          "action": "$demo"
        }
      ]
    }
  ],
  "skill": "skill/SKILL.md",
  "sync": {
    "genome": {
      "mode": "shared",
      "rate": "commit"
    },
    "locus": {
      "mode": "shared",
      "rate": "stream"
    }
  }
}
