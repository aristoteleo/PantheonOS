{
  "id": "cytoscape",
  "name": "Cytoscape",
  "version": "0.1.0",
  "apiVersion": 2,
  "description": "Interactive biological networks and pathways (Cytoscape.js).",
  "kind": "service",
  "surface": "dom",
  "entry": {
    "frontend": "frontend/index.js"
  },
  "placement": {
    "requires": [
      "dom"
    ]
  },
  "opens": [
    ".cyjs"
  ],
  "defaultFor": [],
  "launcher": false,
  "icon": {
    "tint": "#f7df1e",
    "path": "assets/icon.svg"
  },
  "actions": [
    {
      "name": "setLayout",
      "params": {
        "name": "cose | circle | grid | breadthfirst | concentric"
      },
      "description": "Re-run the graph layout"
    }
  ],
  "caps": {
    "fs": [],
    "net": true
  },
  "menus": [
    {
      "label": "Data",
      "items": [
        {
          "label": "Load Example Data",
          "action": "$demo"
        }
      ]
    },
    {
      "label": "View",
      "items": [
        {
          "label": "Cose Layout",
          "action": "setLayout",
          "args": {
            "name": "cose"
          }
        },
        {
          "label": "Circle Layout",
          "action": "setLayout",
          "args": {
            "name": "circle"
          }
        },
        {
          "label": "Grid Layout",
          "action": "setLayout",
          "args": {
            "name": "grid"
          }
        },
        {
          "label": "Breadth-first Layout",
          "action": "setLayout",
          "args": {
            "name": "breadthfirst"
          }
        },
        {
          "label": "Concentric Layout",
          "action": "setLayout",
          "args": {
            "name": "concentric"
          }
        }
      ]
    }
  ],
  "skill": "skill/SKILL.md",
  "sync": {
    "elements": {
      "mode": "shared",
      "rate": "commit"
    },
    "layout": {
      "mode": "shared",
      "rate": "commit"
    }
  }
}
