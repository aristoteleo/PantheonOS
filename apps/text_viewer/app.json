{
  "id": "text-viewer",
  "name": "Text Viewer",
  "version": "0.6.4",
  "apiVersion": 2,
  "description": "View text and code files.",
  "surface": "dom",
  "entry": {
    "frontend": "frontend/main.js"
  },
  "placement": {
    "requires": [
      "dom"
    ]
  },
  "notes": "Bundled headed App (CodeMirror, esbuild-built from frontend-src/ — see build.sh). Reads via the served URL, saves through the bridge fs broker.",
  "opens": [
    ".txt",
    ".md",
    ".log",
    ".json",
    ".yaml",
    ".yml",
    ".toml",
    ".cfg",
    ".ini",
    ".csv",
    ".tsv",
    ".py",
    ".r",
    ".jl",
    ".sh",
    ".js",
    ".ts",
    ".vue",
    ".css",
    ".html",
    ".xml",
    ".sql",
    ".rs",
    ".go",
    ".c",
    ".h",
    ".cpp",
    ".java",
    ".gitignore",
    ".env",
    ".lock"
  ],
  "defaultFor": [],
  "launcher": false,
  "icon": {
    "monochrome": true,
    "tint": "#5a6273"
  },
  "defaultSize": {
    "width": 820,
    "height": 560
  },
  "caps": {
    "fs": [
      "read",
      "write"
    ]
  }
}
