{
  "id": "viv",
  "name": "Viv - BioImage",
  "version": "0.1.0",
  "apiVersion": 2,
  "description": "Multiscale bioimage viewer for OME-TIFF/Zarr — pyramidal, multi-channel (Viv/deck.gl).",
  "kind": "service",
  "surface": "dom",
  "entry": {
    "frontend": "frontend/index.js",
    "backend": "backend"
  },
  "placement": {
    "requires": [
      "dom"
    ]
  },
  "opens": [
    ".ome.tif",
    ".ome.tiff",
    ".ome.zarr",
    ".zarr",
    ".tif",
    ".tiff"
  ],
  "defaultFor": [
    ".ome.tif",
    ".ome.tiff",
    ".ome.zarr",
    ".zarr",
    ".tif",
    ".tiff"
  ],
  "launcher": true,
  "icon": {
    "path": "assets/icon.svg",
    "tint": "#3fb27f"
  },
  "actions": [
    {
      "name": "showChannels",
      "in": "frontend",
      "description": "Reveal the channel controls panel."
    }
  ],
  "caps": {
    "fs": [],
    "net": true,
    "python": {
      "env": "pantheon-base"
    }
  },
  "persistState": [
    "channels"
  ],
  "menus": [
    {
      "label": "Data",
      "items": [
        {
          "label": "Load Example Data",
          "action": "$demo"
        }
      ]
    },
    {
      "label": "View",
      "items": [
        {
          "label": "Show Channels",
          "action": "showChannels"
        }
      ]
    }
  ],
  "skill": "skill/SKILL.md",
  "notes": "Path-form backend (atrium stdio process) — runner supervision and placement.requires for the backend land in R2.",
  "sync": {
    "channels": {
      "mode": "shared",
      "rate": "commit"
    },
    "viewState": {
      "mode": "shared",
      "rate": "stream"
    }
  }
}
